    {
      "cell_type": "code",
      "source": [
        "import json\n",
        "def save_to_file(memory_list):\n",
        "  with open('memories.json' ,'w') as f:\n",
        "    json.dump(memory_list, f)\n",
        "  print(\"Memories saved to file !\")\n",
        "\n",
        "def load_from_file():\n",
        "  try:\n",
        "    with open('memories.json' , 'r') as f :\n",
        "      return json.load(f)\n",
        "  except:\n",
        "    return []\n",
        "# Test it\n",
        "memory = load_from_file()\n",
        "memory.append(\"I am building a memory center\")\n",
        "save_to_file(memory)"
      ],
      "metadata": {
        "id": "OKlAmQ83GgZq"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def add_memory(text):\n",
        "  memories = load_from_file()\n",
        "  memories.append(text)\n",
        "  save_to_file(memories)\n",
        "  print(f\"Added: {text}\")\n",
        "\n",
        "def show_memories():\n",
        "  memories = load_from_file()\n",
        "  if not memories :\n",
        "   print(\"No memories yet!\")\n",
        "  else:\n",
        "    print(\"--- YOUR MEMORIES ---\")\n",
        "    for i, m in enumerate(memories):\n",
        "      print(f\"{i+1}. {m}\")\n",
        "\n",
        "#Test\n",
        "add_memory(\"I am learning Python\")\n",
        "show_memories()"
      ],
      "metadata": {
        "id": "0oz05bCqKsCy"
      },
      "execution_count": null,
      "outputs": []
