        "import requests\n",
        "\n",
        "def chat_with_anastasiya(your_message):\n",
        "\n",
        "    memories = load_from_file()\n",
        "    memory_text = \"\\n\" .join([f\"-{m}\"for m in memories])\n",
        "\n",
        "    api_key = \"YOUR_GEMINI_KEY_HERE\"\n",
        "\n",
        "    response = requests.post(\n",
        "        f\"https://generativelanguage.googleapis.com/v1/models/gemini-2.5-flash:generateContent?key={api_key}\",\n",
        "        json={\n",
        "            \"contents\": [{\n",
        "                \"parts\": [{\n",
        "                    \"text\": f\"You know this about the user:\\n{memory_text}\\n\\nUsersays: {your_message}:\"\n",
        "                }]\n",
        "            }]\n",
        "\n",
        "        }\n",
        "\n",
        "    )\n",
        "\n",
        "    result = response.json()\n",
        "    # Handle potential API errors where 'candidates' might not be present\n",
        "    if 'candidates' not in result:\n",
        "        print(\"API response did not contain 'candidates'. Full response:\")\n",
        "        print(result)\n",
        "        return \"Error: Could not get a response from Gemini.\"\n",
        "    return result['candidates'] [0] ['content'] ['parts'] [0] ['text']\n",
        "\n",
        "# TEST\n",
        "response = chat_with_anastasiya(\"Who am I and what am I building ?\")\n",
        "print(response)\n"
