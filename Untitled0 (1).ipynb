    {
      "cell_type": "code",
      "source": [
        "def delete_memory(number) :\n",
        "  memories = load_from_file()\n",
        "  if 0 < number < len(memories):\n",
        "    removed = memories.pop(number - 1)\n",
        "    save_to_file(memories)\n",
        "    print(f\"Deleted: {removed} \")\n",
        "  else:\n",
        "    print(\"Invalid number\")\n",
        "\n",
        "# Test - show memories first then delete one\n",
        "show_memories()\n",
        "delete_memory(1)\n",
        "show_memories()"
      ],
